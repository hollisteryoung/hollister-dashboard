                  "Value": "'\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport textwrap\ndf = dataset.copy().sort_values(\"Rank\")\nitems = [textwrap.wrap(str(t), width=150) or [str(t)] for t in df[\"Text\"]]\ntotal_lines = sum(len(l) for l in items) or 1\nfig, ax = plt.subplots(figsize=(31.2, 5), dpi=300)\nax.set_xlim(0, 1)\nax.set_ylim(0, 1)\nax.axis(\"off\")\nline_h = 1.0 / total_lines\ny = 1.0\nfor lines in items:\n    ax.text(0.012, y - line_h * 0.5, \"\\u2022\", fontsize=26, fontweight=\"bold\", color=\"#1E194B\", va=\"center\")\n    for j, ln in enumerate(lines):\n        ax.text(0.03, y - line_h * (j + 0.5), ln, fontsize=21, color=\"#2d3436\", va=\"center\")\n    y -= line_h * len(lines)\nplt.subplots_adjust(left=0.006, right=0.994, top=0.97, bottom=0.03)\nplt.show()\n'"
