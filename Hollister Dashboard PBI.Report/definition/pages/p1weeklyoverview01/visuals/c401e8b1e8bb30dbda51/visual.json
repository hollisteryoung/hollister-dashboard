            "source": {
              "expr": {
                "Literal": {
                  "Value": "'\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\ndf = dataset.copy()\nkeys = sorted(df[\"ShiftKey\"].dropna().unique(), reverse=True)[:14]\ndf = df[df[\"ShiftKey\"].isin(keys)]\nrows = []\nfor k in keys:\n    sub = df[df[\"ShiftKey\"] == k].sort_values(\"Rank\")\n    if sub.empty:\n        continue\n    top = sub.iloc[0]\n    extra = len(sub) - 1\n    head = top[\"Headline\"] + (\" +%d more\" % extra if extra > 0 else \"\")\n    rows.append((top[\"ShiftLabel\"], head, top[\"Detail\"], top[\"SegColor\"]))\nfig, ax = plt.subplots(figsize=(31.2, 14), dpi=300)\nax.set_xlim(0, 1)\nax.set_ylim(0, 1)\nax.axis(\"off\")\nn = len(rows)\nif n == 0:\n    ax.text(0.012, 0.5, \"No unusual shifts detected.\", fontsize=21, color=\"#636e72\", va=\"center\")\nelse:\n    row_h = 1.0 / n\n    for i, (label, head, detail, color) in enumerate(rows):\n        y_top = 1 - i * row_h\n        y_c = y_top - row_h / 2\n        c = color if isinstance(color, str) and color.startswith(\"#\") else \"#636e72\"\n        ax.add_patch(plt.Rectangle((0.0, y_top - row_h + row_h * 0.14), 0.004, row_h * 0.72, color=c, clip_on=False))\n        ax.text(0.016, y_c, label, fontsize=19, fontweight=\"bold\", color=\"#636e72\", va=\"center\")\n        ax.text(0.10, y_c + row_h * 0.16, head, fontsize=21, fontweight=\"bold\", color=\"#2d3436\", va=\"center\")\n        ax.text(0.10, y_c - row_h * 0.24, detail, fontsize=18, color=\"#636e72\", va=\"center\")\n        if i < n - 1:\n            ax.axhline(y_top - row_h, color=\"#f0f0f0\", linewidth=2, xmin=0, xmax=1)\nplt.subplots_adjust(left=0.006, right=0.994, top=0.99, bottom=0.01)\nplt.show()\n'"
                }
              }
