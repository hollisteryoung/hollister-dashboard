            "source": {
              "expr": {
                "Literal": {
                  "Value": "'\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\ndf = dataset.copy()\ndf[\"Lane\"] = df[\"Lane\"].astype(int)\ndf[\"BatchIdx\"] = df[\"BatchIdx\"].astype(int)\nxs = sorted(df[\"BatchIdx\"].unique())\npos = {v: i for i, v in enumerate(xs)}\ncolors = [\"#264653\",\"#e76f51\",\"#e9c46a\",\"#0077b6\",\"#2a9d8f\",\"#6a4c93\",\"#f4a261\",\"#48bfe3\",\"#8338ec\",\"#d4a373\"]\nfig, ax = plt.subplots(figsize=(31.2, 8.4), dpi=300)\nfor i, (lane, g) in enumerate(df.groupby(\"Lane\")):\n    g = g.sort_values(\"BatchIdx\")\n    c = colors[i % len(colors)]\n    x = [pos[v] for v in g[\"BatchIdx\"]]\n    ax.plot(x, list(g[\"Ewma\"]), marker=\"o\", markersize=6, color=c, linewidth=4, label=\"N%d\" % lane)\n    ucl = g[\"Ucl\"].mean()\n    if ucl > 0:\n        ax.plot([0, len(xs)-1], [ucl, ucl], linestyle=\"--\", color=c, alpha=0.3, linewidth=2)\n        b = g[g[\"Ewma\"] > g[\"Ucl\"]]\n        if len(b):\n            ax.scatter([pos[v] for v in b[\"BatchIdx\"]], list(b[\"Ewma\"]), marker=\"x\", s=320, color=\"#d63031\", linewidths=4, zorder=5)\nax.set_ylabel(\"EWMA reject rate %\")\nax.set_ylim(bottom=0)\nax.grid(axis=\"y\", color=\"#eeeeee\")\nfor s in [\"top\", \"right\"]:\n    ax.spines[s].set_visible(False)\nax.legend(loc=\"upper center\", bbox_to_anchor=(0.5, -0.18), ncol=6, fontsize=14, frameon=False)\nplt.tight_layout()\nplt.show()\n'"
                }
              }
            }
