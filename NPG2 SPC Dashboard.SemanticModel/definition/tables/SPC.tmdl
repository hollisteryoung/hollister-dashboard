table SPC
	lineageTag: 05070999-e7dc-4562-ac4e-50d7a8ba0c02

	/// Per-lane reject rate for the cell.
	measure 'Reject Rate %' = SUM(SPC[RatePct])
		formatString: 0.00
		lineageTag: 3f7817ac-5af7-4797-aeb5-055cc0a77ce8

	/// Reject rate for the control chart.
	measure 'Max Reject Rate %' = MAX(SPC[RatePct])
		formatString: 0.00
		lineageTag: 7ee0fbde-1f3f-467d-a8af-31784cfe09e8

	/// Upper control limit.
	measure 'UCL %' = MAX(SPC[UclPct])
		formatString: 0.00
		lineageTag: 9fe2ace9-d332-46be-8b50-a22ab660eac9

	/// Reject count.
	measure 'Total Rejects' = SUM(SPC[Rejects])
		formatString: #,##0
		lineageTag: 24f1fea6-46c1-4a27-9448-22a56b2f8cd9

	/// 1 when the lane is out of control.
	measure 'Out of Control' = MAX(SPC[OOC])
		formatString: 0
		lineageTag: ea4eb6ef-e185-42f5-ba74-34898303ef82

