table gold_EWMA_Hourly
	lineageTag: 7fb9c08b-d264-4158-a806-a430b1998f27

	measure 'EWMA %' = MAX(gold_EWMA_Hourly[Ewma])
		formatString: 0.00
		lineageTag: c5cd8b08-8ef0-4cc7-b0f8-00d5c211c431

	measure 'EWMA UCL %' = MAX(gold_EWMA_Hourly[Ucl])
		formatString: 0.00
		lineageTag: bf2858b8-d42b-47c8-9216-788c9b9adadb

	measure 'EWMA LCL %' = MAX(gold_EWMA_Hourly[Lcl])
		formatString: 0.00
		lineageTag: a3278e98-d127-45d5-a5ed-c78f2b691c49

	measure 'EWMA Out of Control' = MAX(gold_EWMA_Hourly[OOC])
		formatString: 0
		lineageTag: bfdd597a-3438-424a-b728-70c1edb1ad38

	measure 'Common UCL' = AVERAGEX(VALUES(gold_EWMA_Hourly[LaneLabel]), CALCULATE(MAX(gold_EWMA_Hourly[Ucl])))
		formatString: 0.00

