model Model
	culture: en-IE
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","RemoteModeling"]

annotation PBI_QueryOrder = ["Shifts","SPC","Lines","Snapshots"]

ref table Lines
ref table Shifts
ref table SPC
ref table Snapshots

ref cultureInfo en-IE

