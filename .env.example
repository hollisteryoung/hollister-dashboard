# SQL Server credentials for the analysis pipeline / Power BI compute bridge.
# Copy to `.env` (exact name — not .env.txt) and fill in real values.

# Password for the SQL login (DB_PASSWORD preferred; MSSQL_SA_PASSWORD still works).
export DB_PASSWORD=your_password_here

# SQL login username. Defaults to 'sa'; set this when using a named login.
# export DB_USER=your_sql_login

# Server host,port. Defaults to localhost,1433.
# Use the remote server's address, e.g. 10.62.27.4,1433
# export DB_SERVER=10.62.27.4,1433

# Optional: default line without passing --line each time (ngp2 or hu3)
# LINE=ngp2
